<mxfile host="app.diagrams.net"><diagram name="Architecture" id="sparkify-architecture"><mxGraphModel dx="1400" dy="700" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="580" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Sparkify Music Analytics — ETL and Cassandra Data Modeling" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="8" width="1500" height="36" as="geometry"/></mxCell><mxCell id="cass" value="" style="rounded=1;dashed=1;fillColor=none;strokeColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="830" y="66" width="430" height="466" as="geometry"/></mxCell><mxCell id="lbl0" value="RAW DATA" style="text;html=1;align=center;fontSize=11;fontStyle=1;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="20.0" y="106" width="200" height="20" as="geometry"/></mxCell><mxCell id="lbl1" value="TRANSFORM" style="text;html=1;align=center;fontSize=11;fontStyle=1;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="295.0" y="106" width="200" height="20" as="geometry"/></mxCell><mxCell id="lbl2" value="PROCESSED" style="text;html=1;align=center;fontSize=11;fontStyle=1;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="570.0" y="106" width="200" height="20" as="geometry"/></mxCell><mxCell id="lbl3" value="APACHE CASSANDRA · KEYSPACE sparkify" style="text;html=1;align=center;fontSize=11;fontStyle=1;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="845.0" y="42" width="400" height="20" as="geometry"/></mxCell><mxCell id="lbl4" value="ANALYTICAL QUERIES" style="text;html=1;align=center;fontSize=11;fontStyle=1;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="1285.0" y="42" width="200" height="20" as="geometry"/></mxCell><mxCell id="raw" value="&lt;b&gt;Sparkify Event Logs&lt;/b&gt;&lt;br&gt;data/raw/&lt;br&gt;30 daily CSV files&lt;br&gt;November 2018" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="20" y="215" width="200" height="120" as="geometry"/></mxCell><mxCell id="etl" value="&lt;b&gt;Python ETL&lt;/b&gt;&lt;br&gt;src/preprocessing.py&lt;br&gt;1. Discover daily files (sorted)&lt;br&gt;2. Read events&lt;br&gt;3. Exclude non-playback rows&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(no&amp;nbsp;artist)&lt;br&gt;4. Select 11 columns by name&lt;br&gt;5. Write consolidated CSV" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="270" y="150" width="250" height="250" as="geometry"/></mxCell><mxCell id="proc" value="&lt;b&gt;Processed Data&lt;/b&gt;&lt;br&gt;data/processed/&lt;br&gt;event_datafile_new.csv&lt;br&gt;6,820 playback events&lt;br&gt;11 columns" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=2;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="570" y="215" width="200" height="120" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b&gt;Table 1: song_by_session_item&lt;/b&gt;&lt;br&gt;PRIMARY KEY (session_id, item_in_session)&lt;br&gt;Partition key: session_id&lt;br&gt;Clustering column: item_in_session&lt;br&gt;One row per play in a session" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=2;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="850" y="95" width="390" height="125" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b&gt;Table 2: song_by_user_session&lt;/b&gt;&lt;br&gt;PRIMARY KEY ((user_id, session_id), item_in_session)&lt;br&gt;Partition key: (user_id, session_id)&lt;br&gt;Clustering column: item_in_session ASC&lt;br&gt;One user's session history, in order" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=2;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="850" y="240" width="390" height="125" as="geometry"/></mxCell><mxCell id="t3" value="&lt;b&gt;Table 3: listeners_by_song&lt;/b&gt;&lt;br&gt;PRIMARY KEY (song, user_id)&lt;br&gt;Partition key: song&lt;br&gt;Clustering column: user_id&lt;br&gt;One row per distinct listener of a song" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=2;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="850" y="385" width="390" height="125" as="geometry"/></mxCell><mxCell id="q1" value="&lt;b&gt;Query 1&lt;/b&gt;&lt;br&gt;session 338,&lt;br&gt;item 4&lt;br&gt;→ artist, song,&lt;br&gt;length" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1300" y="95" width="170" height="125" as="geometry"/></mxCell><mxCell id="q2" value="&lt;b&gt;Query 2&lt;/b&gt;&lt;br&gt;user 10,&lt;br&gt;session 182&lt;br&gt;→ artist, song,&lt;br&gt;name, in order" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1300" y="240" width="170" height="125" as="geometry"/></mxCell><mxCell id="q3" value="&lt;b&gt;Query 3&lt;/b&gt;&lt;br&gt;song 'All Hands&lt;br&gt;Against His Own'&lt;br&gt;→ listener&lt;br&gt;names" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1300" y="385" width="170" height="125" as="geometry"/></mxCell><mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6b7280;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="raw" target="etl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6b7280;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="etl" target="proc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6b7280;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="proc" target="t1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6b7280;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="proc" target="t2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6b7280;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="proc" target="t3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6b7280;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="t1" target="q1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6b7280;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="t2" target="q2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6b7280;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="t3" target="q3"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>